*.md
# pyproject declares `readme = "README.md"`; without this exception every
# `pip install -e .` in the container builds emits
# "SetuptoolsWarning: File 'README.md' cannot be found" and ships wheel
# metadata with an empty long description.
!README.md
.env
.env.*
*.tfvars
*.tfstate
*.tfstate.*
.terraform/
node_modules/
.vscode/
.idea/
# Local SQLite dev store (provider=local) — runtime state, never in an image.
henchmen_*.db
henchmen_*.db-shm
henchmen_*.db-wal
