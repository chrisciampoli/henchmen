# Henchmen configuration
#
# The fastest way to produce a working .env.local is to let the wizard write
# one for you — it validates every credential against the real API, lists the
# models your key can reach, and shows your Slack channels to pick from:
#
#     henchmen init
#
# This file documents the same settings for anyone who prefers to edit by
# hand. Every value is optional unless marked required. Names are case
# insensitive and always carry the HENCHMEN_ prefix; the token settings also
# accept the bare names a Cloud Run secret mount injects (GITHUB_TOKEN,
# SLACK_BOT_TOKEN, ...), with the HENCHMEN_ name winning when both are set.
#
# The full reference is src/henchmen/config/settings.py.

# =============================================================================
# PROVIDER SELECTION  (required)
# =============================================================================
# local = Docker on this machine, SQLite, in-memory queues
# gcp   = Cloud Run, Firestore, Pub/Sub, GCS        (see docs/deploy-gcp.md)
# aws   = ECS, DynamoDB, S3, SNS/SQS                (experimental)
HENCHMEN_PROVIDER=local
HENCHMEN_ENVIRONMENT=dev

# Per-service overrides. Leave unset to use HENCHMEN_PROVIDER for everything.
# HENCHMEN_MESSAGE_BROKER_PROVIDER=
# HENCHMEN_DOCUMENT_STORE_PROVIDER=
# HENCHMEN_OBJECT_STORE_PROVIDER=
# HENCHMEN_CONTAINER_ORCHESTRATOR_PROVIDER=
# HENCHMEN_CI_PROVIDER=

# =============================================================================
# LLM PROVIDER  (required)
# =============================================================================
# One of: anthropic, openai, local (Ollama), gcp (Vertex AI), aws (Bedrock).
# The aliases ollama, vertex and bedrock are accepted.
#
# Scheme nodes never name a concrete model. They name a tier, and the provider
# below resolves it:
#
#   default/complex    core coding            implement_fix, implement_feature
#   default/light      cheap, high-volume     planning, classification
#   default/reasoning  hardest steps          fix_tests, analyze_goal
#
# Every tier has a default, so you only set the ones you want to change.

HENCHMEN_LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Option A: Anthropic  (recommended — most reliable tool calling)
# -----------------------------------------------------------------------------
# Key: https://console.anthropic.com/settings/keys
HENCHMEN_ANTHROPIC_API_KEY=sk-ant-...
# HENCHMEN_ANTHROPIC_MODEL_COMPLEX=claude-sonnet-5
# HENCHMEN_ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
# HENCHMEN_ANTHROPIC_MODEL_REASONING=claude-opus-5

# -----------------------------------------------------------------------------
# Option B: OpenAI
# -----------------------------------------------------------------------------
# Key: https://platform.openai.com/api-keys
# HENCHMEN_LLM_PROVIDER=openai
# HENCHMEN_OPENAI_API_KEY=sk-...
# HENCHMEN_OPENAI_MODEL_COMPLEX=gpt-4.1
# HENCHMEN_OPENAI_MODEL_LIGHT=gpt-4.1-mini
# HENCHMEN_OPENAI_MODEL_REASONING=o3

# -----------------------------------------------------------------------------
# Option C: Ollama  (free, experimental)
# -----------------------------------------------------------------------------
# Needs a model with real tool-calling support; smaller models routinely fail
# the multi-step tool loop an operative runs. Start Ollama, then:
#     ollama pull qwen2.5-coder:7b
# HENCHMEN_LLM_PROVIDER=local
# HENCHMEN_LLM_OLLAMA_BASE_URL=http://localhost:11434
# HENCHMEN_LLM_OLLAMA_MODEL=qwen2.5-coder:7b
# Per-tier overrides; each falls back to HENCHMEN_LLM_OLLAMA_MODEL when empty.
# HENCHMEN_LLM_OLLAMA_MODEL_COMPLEX=qwen2.5-coder:7b
# HENCHMEN_LLM_OLLAMA_MODEL_LIGHT=qwen2.5:3b
# HENCHMEN_LLM_OLLAMA_MODEL_REASONING=deepseek-r1:8b

# -----------------------------------------------------------------------------
# Option D: Vertex AI  (Gemini only — Claude models are not used on Vertex)
# -----------------------------------------------------------------------------
# Auth is Application Default Credentials: gcloud auth application-default login
# HENCHMEN_LLM_PROVIDER=gcp
# HENCHMEN_VERTEX_AI_MODEL_COMPLEX=gemini-2.5-pro
# HENCHMEN_VERTEX_AI_MODEL_LIGHT=gemini-2.5-flash
# HENCHMEN_VERTEX_AI_MODEL_REASONING=gemini-3.1-pro

# -----------------------------------------------------------------------------
# Option E: AWS Bedrock  (experimental)
# -----------------------------------------------------------------------------
# HENCHMEN_LLM_PROVIDER=aws
# HENCHMEN_AWS_REGION=us-east-1
# HENCHMEN_BEDROCK_MODEL_COMPLEX=anthropic.claude-sonnet-4-20250514-v1:0
# HENCHMEN_BEDROCK_MODEL_LIGHT=anthropic.claude-haiku-4-5-20251001-v1:0
# HENCHMEN_BEDROCK_MODEL_REASONING=anthropic.claude-sonnet-4-20250514-v1:0

# Model behind `henchmen chat`. Empty means the active provider's light tier.
# HENCHMEN_LLM_CHAT_MODEL=

# =============================================================================
# GITHUB  (required to open pull requests)
# =============================================================================
# A classic personal access token with the `repo` scope, from an account that
# can push to the target repository: https://github.com/settings/tokens
# (Henchmen does not use a GitHub App; HENCHMEN_GITHUB_APP_* are reserved.)
HENCHMEN_GITHUB_TOKEN=ghp_...
HENCHMEN_GITHUB_DEFAULT_REPO=your-org/your-repo
# HENCHMEN_GITHUB_DEFAULT_ORG=your-org
# Shared secret for the /webhooks/github signature check. Required in
# staging and prod; without it dev accepts unsigned webhooks and says so.
# HENCHMEN_GITHUB_WEBHOOK_SECRET=

# Git identity on the commits operatives push.
HENCHMEN_GIT_AUTHOR_NAME=Henchmen Operative
HENCHMEN_GIT_AUTHOR_EMAIL=henchmen-operative@noreply.local

# =============================================================================
# SLACK  (optional — @mention the bot to create a task)
# =============================================================================
# Create an app at https://api.slack.com/apps, enable Socket Mode, and give the
# bot these scopes: app_mentions:read, chat:write, channels:history,
# channels:read, channels:join, groups:read. The app-level token needs
# connections:write.
#
# The bot runs inside the Dispatch process. On startup it joins
# HENCHMEN_SLACK_NOTIFICATION_CHANNEL and posts status updates there.
# HENCHMEN_SLACK_BOT_TOKEN=xoxb-...
# HENCHMEN_SLACK_APP_TOKEN=xapp-...
# HENCHMEN_SLACK_SIGNING_SECRET=
# HENCHMEN_SLACK_NOTIFICATION_CHANNEL=C0123456789

# =============================================================================
# JIRA  (optional)
# =============================================================================
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# HENCHMEN_JIRA_BASE_URL=https://your-org.atlassian.net
# HENCHMEN_JIRA_EMAIL=service-account@your-org.com
# HENCHMEN_JIRA_API_TOKEN=
# Shared secret for the /webhooks/jira signature check. Required in staging
# and prod; without it every Jira delivery is rejected with 401.
# HENCHMEN_JIRA_WEBHOOK_SECRET=
# Jira webhooks deliver custom fields only as customfield_<number>. Name the
# fields that hold the target repo (owner/repo) and branch. Find an id under
# Jira settings > Issues > Custom fields (the numeric id in the field's page
# URL; 10042 becomes customfield_10042), or
# as the "id" in GET https://your-org.atlassian.net/rest/api/3/field.
# Without a repo field, tasks use HENCHMEN_GITHUB_DEFAULT_REPO.
# HENCHMEN_JIRA_REPO_FIELD=customfield_10042
# HENCHMEN_JIRA_BRANCH_FIELD=customfield_10043

# =============================================================================
# LIMITS
# =============================================================================
# Cumulative spend allowed for one task across every scheme node.
# HENCHMEN_OPERATIVE_TASK_COST_CEILING_USD=6.0
# Wall-clock ceiling for a single operative, in seconds.
# HENCHMEN_OPERATIVE_WALLCLOCK_CEILING_SECONDS=1800
# Output tokens per LLM call. Higher values mean fewer, larger requests.
# HENCHMEN_OPERATIVE_MAX_OUTPUT_TOKENS=16384
# HENCHMEN_OPERATIVE_MAX_SYSTEM_TOKENS=20000
# HENCHMEN_OPERATIVE_MAX_MESSAGE_TOKENS=16000
# Allow operatives to force-push to non-protected branches. Pushing to
# main/master/release* is refused regardless of this setting.
# HENCHMEN_ALLOW_FORCE_PUSH=false

# =============================================================================
# EVALS
# =============================================================================
# SQLite file holding `henchmen eval` run history. Empty means
# ~/.henchmen/eval/results.db.
# HENCHMEN_EVAL_DB_PATH=

# =============================================================================
# LOCAL MODE
# =============================================================================
# Port `henchmen serve` listens on. Operative containers reach the host at
# http://host.docker.internal:<port> to deliver their reports.
# HENCHMEN_LOCAL_SERVE_PORT=8000
# HENCHMEN_LOCAL_FORWARD_BASE_URL=

# =============================================================================
# GCP  (only when HENCHMEN_PROVIDER=gcp — see docs/deploy-gcp.md)
# =============================================================================
# HENCHMEN_GCP_PROJECT_ID=
# HENCHMEN_GCP_REGION=us-central1
# HENCHMEN_FIRESTORE_DATABASE=(default)
# HENCHMEN_GCS_BUCKET_DOSSIER=
# HENCHMEN_GCS_BUCKET_SNAPSHOTS=
# Must match the audience configured on the Pub/Sub push subscriptions, or
# every push is rejected with 401. Required in staging and prod.
# HENCHMEN_PUBSUB_OIDC_AUDIENCE=
# HENCHMEN_PUBSUB_OIDC_ALLOWED_EMAILS=
# Bearer token required by the /metrics endpoints. Required in staging and
# prod; empty in dev leaves them open and logs a warning.
# HENCHMEN_METRICS_AUTH_TOKEN=
# Service account for operative jobs. Empty derives
# sa-<environment>-operative@<project>.iam.gserviceaccount.com.
# HENCHMEN_LAIR_SERVICE_ACCOUNT=

# Vertex AI RAG Engine (semantic code search for the dossier).
# HENCHMEN_RAG_CORPUS_DISPLAY_NAME=henchmen-code
# HENCHMEN_RAG_CORPUS_REGION=us-west1
# HENCHMEN_RAG_EMBEDDING_MODEL=text-embedding-005

# =============================================================================
# AWS  (only when HENCHMEN_PROVIDER=aws — experimental)
# =============================================================================
# HENCHMEN_AWS_REGION=us-east-1
# HENCHMEN_AWS_ACCOUNT_ID=
# HENCHMEN_AWS_ECS_CLUSTER=henchmen
# HENCHMEN_AWS_ECS_SUBNETS=
# HENCHMEN_AWS_ECS_SECURITY_GROUPS=
